== git diff eeaa33299d7ba6df5743375ebeed9475b3f206b4 -- rtl/ (the .sv files; sigil_perf.svh is new and only included under ifndef SYNTHESIS)
diff --git a/rtl/core/sigil_cpu.sv b/rtl/core/sigil_cpu.sv
index 9a990bc..355c945 100644
--- a/rtl/core/sigil_cpu.sv
+++ b/rtl/core/sigil_cpu.sv
@@ -220,5 +220,11 @@ module sigil_cpu import sigil_cache_pkg::*; #(
       .rsp_valid_i    (bus_rsp_valid_i),
       .rsp_last_i     (bus_rsp_last_i)
   );
+
+`ifndef SYNTHESIS
+  // Simulation-only performance event counters (issue #56,
+  // docs/PERFORMANCE.md): passive, never read by synthesis.
+`include "sigil_perf.svh"
+`endif
 endmodule
 `default_nettype wire
diff --git a/rtl/core/sigil_dcache.sv b/rtl/core/sigil_dcache.sv
index cd1d8fd..f051268 100644
--- a/rtl/core/sigil_dcache.sv
+++ b/rtl/core/sigil_dcache.sv
@@ -421,6 +421,17 @@ module sigil_dcache import sigil_cache_pkg::*; #(
       (bus_rsp_valid_i && (state_q != S_FILL)) |->
       (bus_rsp_last_i && ((state_q == S_WB_ACK) || (state_q == S_UNC_RSP))))
     else $error("dcache: unexpected bus response");
+  // Performance-counter tap, read hierarchically by the
+  // simulation-only event counters in sigil_cpu (sigil_perf.svh):
+  // the lookup of the current request missed (write-back and/or
+  // refill follow).
+  // Excluded from coverage like the counters themselves.
+  /* verilator coverage_off */
+  /* verilator lint_off UNUSEDSIGNAL */
+  logic perf_miss;
+  assign perf_miss = (state_q == S_LOOKUP) && !hit;
+  /* verilator lint_on UNUSEDSIGNAL */
+  /* verilator coverage_on */
 `endif
 endmodule
 `default_nettype wire
diff --git a/rtl/core/sigil_icache.sv b/rtl/core/sigil_icache.sv
index be0ad2e..eb13c99 100644
--- a/rtl/core/sigil_icache.sv
+++ b/rtl/core/sigil_icache.sv
@@ -287,6 +287,16 @@ module sigil_icache import sigil_cache_pkg::*; #(
       (bus_rsp_valid_i && (state_q != S_FILL)) |->
       (bus_rsp_last_i && (state_q == S_UNC_RSP)))
     else $error("icache: unexpected bus response");
+  // Performance-counter tap, read hierarchically by the
+  // simulation-only event counters in sigil_cpu (sigil_perf.svh):
+  // the lookup of the current request missed (a refill follows).
+  // Excluded from coverage like the counters themselves.
+  /* verilator coverage_off */
+  /* verilator lint_off UNUSEDSIGNAL */
+  logic perf_miss;
+  assign perf_miss = (state_q == S_LOOKUP) && !hit;
+  /* verilator lint_on UNUSEDSIGNAL */
+  /* verilator coverage_on */
 `endif
 endmodule
 `default_nettype wire
