diff --git a/rtl/core/sigil_core.sv b/rtl/core/sigil_core.sv
index ebe714f..e303850 100644
--- a/rtl/core/sigil_core.sv
+++ b/rtl/core/sigil_core.sv
@@ -1651,6 +1651,22 @@ module sigil_core import sigil_pkg::*, sigil_cache_pkg::*; (
     end
   end
 
+`ifndef SYNTHESIS
+  // verilator lint_off PROCASSINIT
+  int unsigned lp_lock = 0, lp_needs = 0, lp_data = 0, lp_unxl = 0, lp_fencei = 0, lp_block = 0, lp_wwait = 0;
+  always @(posedge clk_i) if (rst_ni && walk_lock) begin
+    lp_lock <= lp_lock + 1;
+    if (mem_needs_port) lp_needs <= lp_needs + 1;
+    if (data_access) lp_data <= lp_data + 1;
+    if (data_access && !mmu_d_ok) lp_unxl <= lp_unxl + 1;
+    if (mem_fencei) lp_fencei <= lp_fencei + 1;
+    if (mem_needs_port && !dq_pend_q && !trap_fire && !freeze) lp_block <= lp_block + 1;
+    if (walk_req && !dq_pend_q && !walk_issue && !walk_skip) lp_wwait <= lp_wwait + 1;
+  end
+  final $display("LOCKPROBE lock=%0d needs=%0d data=%0d unxl=%0d fencei=%0d block=%0d wwait=%0d",
+                 lp_lock, lp_needs, lp_data, lp_unxl, lp_fencei, lp_block, lp_wwait);
+  // verilator lint_on PROCASSINIT
+`endif
   // A MEM access in flight is never abandoned: nothing older can
   // trap while it waits (WB is frozen behind mem_stall).
 `ifndef SYNTHESIS
