export DESIGN_NAME = sigil_soc_top
export PLATFORM    = nangate45
# Core RTL is full SystemVerilog (packages/imports): the
# default Yosys Verilog-2005 frontend rejects it, use the
# slang frontend built into the ORFS Yosys.
export SYNTH_HDL_FRONTEND = slang
# Whole-vector/FPU combinational loops exceed slang's
# default 4000 unroll limit (fp_eval + 512-wide vec).
# -DSYNTHESIS drops simulation-only blocks (`ifndef SYNTHESIS checks).
# ORFS's synth_preamble.tcl already passes -D SYNTHESIS to read_slang;
# it is repeated here so the intent does not depend on that, and to
# match scripts/synth_block_orfs.sh.
export SYNTH_SLANG_ARGS = --unroll-limit=200000 -DSYNTHESIS -DSIGIL_SRAM_FAKERAM45
# SRAM macros (SIGIL_SRAM_FAKERAM45; see docs/SOC_AREA.md):
#   VRF banks, 3x 256x64 1R1W byte-write: fakeram45_256x64_1r1w,
#     generated by sram/gen_fakeram45_1r1w.py (ORFS ships only 1RW
#     fakeram45 views and no 256x64).
#   L1 data ways, 6x 512x64: stock fakeram45_512x64.
#   L1 tag ways, 6x 64x44: fakeram45_64x44, generated 1RW view.
# The .v models give slang the ports; the .libs blackbox them.
SRAM_DIR = $(DESIGN_HOME)/$(PLATFORM)/sigil_soc/sram
export ADDITIONAL_LEFS = $(SRAM_DIR)/fakeram45_256x64_1r1w.lef \
  $(PLATFORM_DIR)/lef/fakeram45_512x64.lef $(SRAM_DIR)/fakeram45_64x44.lef
export ADDITIONAL_LIBS = $(SRAM_DIR)/fakeram45_256x64_1r1w.lib \
  $(PLATFORM_DIR)/lib/fakeram45_512x64.lib $(SRAM_DIR)/fakeram45_64x44.lib
# SoC RTL list shared with the other platform's config (located
# relative to this file: DESIGN_HOME is not yet set while ORFS reads
# the design config).
include $(abspath $(dir $(lastword $(MAKEFILE_LIST)))../../src/sigil_soc/sigil_soc_files.mk)
# Tree is the repo rtl/, mounted at designs/src/sigil_soc by
# openroad_docker.sh.
export VERILOG_FILES = \
  $(SRAM_DIR)/fakeram45_256x64_1r1w.v \
  $(SRAM_DIR)/fakeram45_512x64.v \
  $(SRAM_DIR)/fakeram45_64x44.v \
  $(addprefix $(DESIGN_HOME)/src/sigil_soc/,$(SIGIL_SOC_RTL))
# sigil_fpu_ops.svh is `included by sigil_fpu_pkg.sv and
# sigil_fpu.sv.
export VERILOG_INCLUDE_DIRS = $(DESIGN_HOME)/src/sigil_soc/core
# With the VRF banks and L1 arrays on macros, the core's largest inferred
# memories are the 32x64 int/FP regfiles (2048 bits). W3 (#6) put sha512_block in the SoC: its 80x64 message schedule (5,120
# bits, flops) and its 80-entry K table (padded to 128x64 = 8,192 bits,
# constant logic) exceed ORFS's default 4096-bit inferred-memory guard.
# Both are intended to build from flops/logic, as in the crypto macro.
export SYNTH_MEMORY_MAX_BITS = 8192
export SDC_FILE      = $(DESIGN_HOME)/nangate45/sigil_soc/constraint.sdc
# First full-SoC closure attempt (issue #11 slice): start
# sparse; the combinational FPU/vector datapaths, not
# utilization, are expected to set Fmax. Report honestly.
export CORE_UTILIZATION = 20
# Macro halo: with the default halo the macro placer left ~22 um gaps
# between the SRAM tag macros; nangate45 metal4 PDN straps are on a 56 um
# pitch, so a gap with no strap left a stranded metal1 rail segment and
# 45 unpowered cells (PSM-0069 at 6_report). A 40 um halo makes every
# channel either >= 80 um wide (always crossed by a strap) or row-free.
export MACRO_PLACE_HALO = 40 40
export PLACE_DENSITY_LB_ADDON = 0.05
export CLOCK_PERIOD = 10
export EARLY_SIZING_CAP_RATIO = 0.8
# Same weak-cell ban as the crypto macro (see sigil_crypto
# config.mk for the liberty evidence, #31).
override export DONT_USE_CELLS = TAPCELL_X1 FILLCELL_X1 AOI211_X1 OAI211_X1 \
                        AOI221_X1 OAI221_X1 NOR3_X1 NOR4_X1 NOR4_X2
