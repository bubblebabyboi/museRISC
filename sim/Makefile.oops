# Issue #73 oops hunt: core_tb / soc_rtl_tb builds with the
# simulation-only memory-consistency checker (tb/sv/sigil_oops_chk.sv
# + tb/cpp/oops_chk_dpi.cpp) bound into sigil_cpu.
#   make -C sim -f Makefile.oops oops-core-tb oops-soc-rtl-tb
include Makefile

OOPS_CHK := $(ROOT)/tb/sv/sigil_oops_chk.sv
OOPS_DPI := $(ROOT)/tb/cpp/oops_chk_dpi.cpp
OOPS_VFLAGS := -Wno-UNUSEDSIGNAL -Wno-SYNCASYNCNET

.PHONY: oops-core-tb oops-soc-rtl-tb
oops-core-tb: $(BUILD)/oops_core_tb
oops-soc-rtl-tb: $(BUILD)/oops_soc_rtl_tb

$(BUILD)/oops_core_tb: $(ROOT)/tb/cpp/core_tb.cpp $(ROOT)/tb/cpp/mbus_model.h $(CPU_RTL) $(FPU_INC) \
                       $(OOPS_CHK) $(OOPS_DPI) | $(BUILD) $(OBJ)
	$(VERILATOR) $(VFLAGS) $(OBJ)/oops_core $(OOPS_VFLAGS) --top-module sigil_cpu \
	  "-GC1_BASE=64'h0" "-GC1_SIZE=64'h10000000" \
	  -CFLAGS -I$(abspath $(ROOT)/tb/cpp) \
	  -o $(abspath $@) $(CPU_RTL) $(OOPS_CHK) \
	  $(abspath $(ROOT)/tb/cpp/core_tb.cpp) $(abspath $(OOPS_DPI))

$(BUILD)/oops_soc_rtl_tb: $(ROOT)/tb/cpp/soc_rtl_tb.cpp $(ROOT)/tb/cpp/mbus_model.h $(SOC_RTL) $(FPU_INC) \
                          $(OOPS_CHK) $(OOPS_DPI) | $(BUILD) $(OBJ)
	$(VERILATOR) $(VFLAGS_FAST) $(OBJ)/oops_socrtl $(OOPS_VFLAGS) --top-module sigil_soc_top \
	  -CFLAGS -I$(abspath $(ROOT)/tb/cpp) \
	  -o $(abspath $@) $(SOC_RTL) $(OOPS_CHK) \
	  $(abspath $(ROOT)/tb/cpp/soc_rtl_tb.cpp) $(abspath $(OOPS_DPI))

# The fetch-walk preemption tests (issue #73 oops hunt). Each must
# PASS on fixed RTL; on the RTL of 73-linux-release all three FAIL
# (stale walker response consumed by the preempting data walk).
OOPS_PTW_TESTS := ptw_preempt_directed ptw_preempt_cached_directed ptw_preempt_twoload_directed
.PHONY: oops-ptw-preempt
oops-ptw-preempt: $(BUILD)/oops_core_tb $(addprefix $(BUILD)/,$(addsuffix .bin,$(OOPS_PTW_TESTS)))
	cd $(BUILD) && rc=0; for t in $(OOPS_PTW_TESTS); do \
	  for a in "--mem-lat 1" "$(CORE_RAND_ARGS)" "--mem-lat 40:50"; do \
	    echo "== $$t $$a"; ./oops_core_tb $$t.bin 4000000 $$a | grep -E "CORE TB|OOPSCHK (stale|d-load|i-fetch)" || rc=1; \
	    ./oops_core_tb $$t.bin 4000000 $$a > /dev/null || rc=1; \
	  done; done; exit $$rc

# Other walker-retarget paths the drop-on-preempt fix does not cover
# (issue #73 oops review, other-preemption-paths lens). Each must
# PASS on fixed RTL; on the drop-on-preempt RTL alone they FAIL:
# - ptw_gwidth_redirect_directed: a two-stage (H) fetch walk left in
#   W_G_READ by a GPA-width guest-page fault issues its G-root read
#   and goes to W_IDLE without arming dq_drop; a later fetch redirect
#   or data miss starts a fresh walk that consumes the stale response.
# - ptw_preempt_guest_directed: the drop-on-preempt fix under two-stage
#   (H) translation and HLV (a passing cross-check, kept as coverage).
# - ptw_ad_store_race_directed: the non-atomic Svadu A/D write-back
#   loses an older same-hart store to the leaf PTE (MEM has port
#   priority between W_VS_READ and W_VS_UPD).
OOPS_PTW_OTHER := ptw_gwidth_redirect_directed ptw_preempt_guest_directed ptw_ad_store_race_directed
.PHONY: oops-ptw-other
oops-ptw-other: $(BUILD)/oops_core_tb $(addprefix $(BUILD)/,$(addsuffix .bin,$(OOPS_PTW_OTHER)))
	cd $(BUILD) && rc=0; for t in $(OOPS_PTW_OTHER); do \
	  for a in "--mem-lat 1" "$(CORE_RAND_ARGS)" "--mem-lat 40:50"; do \
	    echo "== $$t $$a"; ./oops_core_tb $$t.bin 4000000 $$a | grep -E "CORE TB|OOPSCHK (stale|d-load|i-fetch)" || rc=1; \
	    ./oops_core_tb $$t.bin 4000000 $$a > /dev/null || rc=1; \
	  done; done; exit $$rc
