/fpga/cl_sigil/build/scripts/*.log
/fpga/cl_sigil/build/scripts/*.jou
/fpga/cl_sigil/build/scripts/.Xil/
/fpga/cl_sigil/build/scripts/to_aws*/
/fpga/cl_sigil/build/constraints/generated_cl_clocks_aws.xdc
