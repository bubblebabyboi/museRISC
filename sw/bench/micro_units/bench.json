{
  "name": "micro_units",
  "description": "Microbenchmarks: M unit and FPU latency (dependent chains) and back-to-back throughput (cycles per operation)",
  "iterations": 1024,
  "max_cycles": 20000000,
  "expect": ["MICRO CHECK OK micro_units iterations={iterations} regions=18"],
  "units": "operations per region (cycles/iter = cycles per operation)",
  "window_region": 1,
  "regions": {
    "1": "empty",
    "2": "mul_dep",
    "3": "mul_indep",
    "4": "div_dep",
    "5": "div_indep",
    "6": "div_short",
    "7": "divw_dep",
    "8": "rem_indep",
    "9": "fadd_d_dep",
    "10": "fadd_d_indep",
    "11": "fmul_d_dep",
    "12": "fmadd_d_dep",
    "13": "fdiv_d_dep",
    "14": "fdiv_d_indep",
    "15": "fsqrt_d_dep",
    "16": "fsqrt_d_indep",
    "17": "fdiv_s_dep",
    "18": "fsqrt_s_dep"
  },
  "region_ops": {
    "1": "region overhead: call + return of an empty kernel (cycles/iter is not per-op)",
    "2": "mul, dependent chain (latency)",
    "3": "mul, independent (back-to-back throughput)",
    "4": "div, dependent, 63 significant quotient bits (x / 1)",
    "5": "div, independent, 63 significant quotient bits",
    "6": "div, independent, dividend smaller than divisor (3 / 7)",
    "7": "divw, dependent, 31 significant quotient bits",
    "8": "rem, independent, 62 significant quotient bits (x % 3)",
    "9": "fadd.d, dependent",
    "10": "fadd.d, independent",
    "11": "fmul.d, dependent",
    "12": "fmadd.d, dependent (x = x * a + b)",
    "13": "fdiv.d, dependent",
    "14": "fdiv.d, independent",
    "15": "fsqrt.d, dependent",
    "16": "fsqrt.d, independent",
    "17": "fdiv.s, dependent",
    "18": "fsqrt.s, dependent"
  }
}
