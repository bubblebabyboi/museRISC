# Sigil kernel configuration fragment (issue #68), applied on top of the
# riscv `defconfig` of Linux 6.12 LTS by scripts/build_linux_kernel.sh
# --regen-defconfig; the result is committed as sigil_defconfig.
#
# Goals: one kernel for the F2 board and the QEMU reference
# (docs/LINUX_PLATFORM.md), able to run Debian with systemd from the
# pmem disk, NUMA with a CPU-less HBM node, user-space Zve64d vector;
# small and quick to boot on a single 62.5 MHz in-order hart (no
# debug instrumentation, no drivers for hardware Sigil does not have).

CONFIG_LOCALVERSION="-sigil"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="sigil"

# --- platform: one Sigil hart, QEMU-virt-like devices ----------------
CONFIG_ARCH_VIRT=y
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STARFIVE is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_CANAAN is not set
# CONFIG_ERRATA_ANDES is not set
# CONFIG_ERRATA_SIFIVE is not set
# CONFIG_ERRATA_THEAD is not set
CONFIG_SMP=y
CONFIG_NR_CPUS=4
CONFIG_HZ_100=y
CONFIG_NUMA=y
CONFIG_NODES_SHIFT=2
# CONFIG_NUMA_BALANCING is not set
# CONFIG_COMPAT is not set
# CONFIG_ACPI is not set
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_SUSPEND is not set
# CONFIG_HIBERNATION is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_RANDOMIZE_BASE is not set

# ISA: Zve64d user-space vector (6.11+ Zve support), B, Zicond
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
CONFIG_RISCV_ISA_V=y
CONFIG_RISCV_ISA_V_DEFAULT_ENABLE=y
# Sigil's vector unit is element-serial: never use it for usercopy.
CONFIG_RISCV_ISA_V_UCOPY_THRESHOLD=1073741824
# CONFIG_RISCV_ISA_V_PREEMPTIVE is not set
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y
CONFIG_RISCV_ISA_ZBC=y
CONFIG_RISCV_PROBE_UNALIGNED_ACCESS=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_PMU_SBI=y

# Hypervisor (H is implemented): KVM built in (the initramfs KVM smoke
# test, sw/linux/kvm_smoke.c, opens /dev/kvm without module loading)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- console, timer, interrupts, power, RTC ---------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=1
CONFIG_SERIAL_8250_RUNTIME_UARTS=1
# CONFIG_SERIAL_8250_DW is not set
# CONFIG_SERIAL_8250_EXTENDED is not set
# CONFIG_SERIAL_8250_PCI is not set
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_MFD_SYSCON=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_DRV_GOLDFISH=y
# CONFIG_RTC_DRV_SUN6I is not set
# CONFIG_VT is not set
CONFIG_UNIX98_PTYS=y

# --- storage: pmem disk (pmem-region -> /dev/pmem0), ext4 root --------
CONFIG_LIBNVDIMM=y
CONFIG_BLK_DEV_PMEM=y
CONFIG_OF_PMEM=y
# BTT selects ND_CLAIM, without which a raw pmem namespace cannot attach
# (devm_nsio_enable() is then a -ENXIO stub and /dev/pmem0 never appears).
CONFIG_BTT=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_AUTOFS_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_FHANDLE=y
CONFIG_FUSE_FS=y
CONFIG_OVERLAY_FS=m
CONFIG_HUGETLBFS=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
# CONFIG_BTRFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_MSDOS_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_9P_FS is not set
# CONFIG_NET_9P is not set
# CONFIG_MTD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_BLK_DEV_NVME is not set

# --- QEMU only: virtio-mmio (sigil-qemu.dts), e.g. a NIC for apt -------
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_INPUT is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_DRM_VIRTIO_GPU is not set
# CONFIG_CRYPTO_DEV_VIRTIO is not set
# CONFIG_RPMSG_VIRTIO is not set

# --- networking: loopback/IPv4/IPv6 for later (#72), no netfilter -----
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
# CONFIG_IP_PNP is not set
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_NET_SCHED is not set
# CONFIG_CAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_ETHERNET is not set
# CONFIG_XFRM_USER is not set
# CONFIG_INET_ESP is not set
# CONFIG_MACVLAN is not set
# CONFIG_IPVLAN is not set
# CONFIG_VXLAN is not set
# CONFIG_VETH is not set
CONFIG_TUN=y

# --- systemd needs ----------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_RT_GROUP_SCHED is not set
# CONFIG_CFS_BANDWIDTH is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_SECURITY_APPARMOR is not set
# CONFIG_AUDIT is not set

# --- hardware Sigil does not have -------------------------------------
# CONFIG_PCI is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_MMC is not set
# CONFIG_SPI is not set
# CONFIG_I2C is not set
# CONFIG_GPIOLIB is not set
# CONFIG_PINCTRL is not set
# CONFIG_DRM is not set
# CONFIG_FB is not set
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_REGULATOR is not set
# CONFIG_DMADEVICES is not set
# CONFIG_IIO is not set
# CONFIG_PM_DEVFREQ is not set
# CONFIG_IOMMU_SUPPORT is not set
# CONFIG_SIFIVE_CCACHE is not set
# CONFIG_RPMSG_CHAR is not set
# CONFIG_RPMSG_CTRL is not set
# CONFIG_MAILBOX is not set
# CONFIG_PHY_SUN4I_USB is not set
# CONFIG_NVMEM_SUNXI_SID is not set
# CONFIG_MFD_AXP20X_I2C is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_MICROSEMI_PHY is not set
# CONFIG_MOTORCOMM_PHY is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_SERIAL_SIFIVE is not set
# CONFIG_MEDIA_CEC_SUPPORT is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_SERIO is not set

# --- speed on a slow single hart: no debug instrumentation ------------
CONFIG_PRINTK_TIME=y
CONFIG_KALLSYMS=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_PAGEALLOC is not set
# CONFIG_SCHED_STACK_END_CHECK is not set
# CONFIG_DEBUG_VM is not set
# CONFIG_DEBUG_VM_PGTABLE is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_DEBUG_PER_CPU_MAPS is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_LIST is not set
# CONFIG_DEBUG_PLIST is not set
# CONFIG_DEBUG_SG is not set
# CONFIG_RCU_EQS_DEBUG is not set
CONFIG_RCU_CPU_STALL_TIMEOUT=120
# CONFIG_MEMTEST is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_KPROBES is not set
CONFIG_INIT_STACK_NONE=y
# CONFIG_INIT_ON_ALLOC_DEFAULT_ON is not set
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
# CONFIG_RUNTIME_TESTING_MENU is not set
