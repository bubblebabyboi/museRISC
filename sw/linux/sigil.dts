/dts-v1/;
/* sigil in-house core, Verilator harness platform (issue #21).
 * Single hart, 128 MiB RAM at 0x8000_0000, CLINT/PLIC/16550 UART
 * modelled in tb/cpp/soc_tb.cpp. Addresses follow docs/SPEC.md. */
/ {
	#address-cells = <2>;
	#size-cells = <2>;
	compatible = "sigil,core";
	model = "Sigil in-house RV64GC core (Verilator)";

	chosen {
		bootargs = "console=ttyS0,115200 earlycon=sbi cryptomgr.notests initcall_debug loglevel=8 rw";
		stdout-path = "serial0";
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <10000000>;

		cpu@0 {
			device_type = "cpu";
			reg = <0>;
			status = "okay";
			compatible = "riscv";
			riscv,isa = "rv64imafdcbh";
			mmu-type = "riscv,sv39";
			clock-frequency = <10000000>;

			cpu0_intc: interrupt-controller {
				#interrupt-cells = <1>;
				interrupt-controller;
				compatible = "riscv,cpu-intc";
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x8000000>;
	};

	soc {
		#address-cells = <2>;
		#size-cells = <2>;
		compatible = "simple-bus";
		ranges;

		clint@2000000 {
			compatible = "sifive,clint0", "riscv,clint0";
			reg = <0x0 0x02000000 0x0 0x10000>;
			interrupts-extended = <&cpu0_intc 3 &cpu0_intc 7>;
		};

		plic: plic@c000000 {
			#interrupt-cells = <1>;
			interrupt-controller;
			compatible = "sifive,plic-1.0.0", "riscv,plic0";
			reg = <0x0 0x0c000000 0x0 0x04000000>;
			riscv,ndev = <32>;
			interrupts-extended = <&cpu0_intc 11 &cpu0_intc 9>;
		};

		serial0: serial@10000000 {
			compatible = "ns16550a";
			reg = <0x0 0x10000000 0x0 0x100>;
			reg-shift = <0>;
			reg-io-width = <1>;
			clock-frequency = <1843200>;
			current-speed = <115200>;
			interrupt-parent = <&plic>;
			interrupts = <10>;
			status = "okay";
		};
	};
};
