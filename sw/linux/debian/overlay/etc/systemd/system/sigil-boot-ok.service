[Unit]
Description=Sigil boot-complete marker on the console
Documentation=https://github.com/bubblebabyboi/sigil/blob/main/docs/LINUX.md
After=systemd-user-sessions.service
Before=serial-getty@ttyS0.service getty.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/sigil-boot-ok

[Install]
WantedBy=multi-user.target
